(* Control of PLC-driven circuits: TEST - verification. *)
(* Generated from the design; every output drops when EStop_OK is FALSE. *)
PROGRAM TEST_verification_Control
VAR_INPUT
    EStop_OK : BOOL; (* Emergency stop chain healthy (normally closed: TRUE while healthy) *)
    Auto_Mode : BOOL; (* Hand/auto selector in auto *)
    Schedule_On : BOOL; (* Time clock or BMS enable *)
    Start_DB_POOL_Q7 : BOOL; (* =DB-POOL-Q7: start (NO) *)
    Stop_DB_POOL_Q7 : BOOL; (* =DB-POOL-Q7: stop (NC) *)
    OL_DB_POOL_Q7 : BOOL; (* =DB-POOL-F2: overload healthy (NC) *)
END_VAR
VAR_OUTPUT
    K_DB_POOL_Q7 : BOOL; (* =DB-POOL-Q7: contactor coil *)
END_VAR

(* =DB-POOL-Q7: Pool filtration pump (TEST VALUE) *)
K_DB_POOL_Q7 := EStop_OK AND Stop_DB_POOL_Q7 AND OL_DB_POOL_Q7 AND ((NOT Auto_Mode AND (Start_DB_POOL_Q7 OR K_DB_POOL_Q7)) OR (Auto_Mode AND Schedule_On));

END_PROGRAM
