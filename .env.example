# PanelPilot environment variables.
#
# Copy to `.env` and fill in real values locally. Never commit a filled-in copy:
# `.env` is gitignored, this file is not. Placeholder values below are
# deliberately non-functional.
#
# Every variable here maps to a field on `Settings` in
# apps/api/app/core/config.py. Adding one without the other will fail startup,
# because the settings model rejects unknown variables.

# --- Runtime ---------------------------------------------------------------
# Deployment environment: dev | staging | prod. Required: there is no default,
# so a deployment that forgets it fails to start rather than running with dev's
# relaxations (short JWT secret, debug, wildcard CORS).
ENVIRONMENT=dev
# Verbose errors and console logging. Refused at startup outside dev: debug
# mode returns tracebacks in error responses.
DEBUG=false
# Minimum log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# URL prefix all v1 routes are mounted under.
API_V1_PREFIX=/api/v1

# --- Postgres --------------------------------------------------------------
# SQLAlchemy DSN for the primary database. The credentials below are
# throwaway local-development values, not secrets; docker compose overrides
# this with the compose service hostname.
DATABASE_URL=postgresql+psycopg://panelpilot:panelpilot@localhost:5432/panelpilot
# Persistent connections held per process.
DATABASE_POOL_SIZE=10
# Extra connections allowed above the pool size under burst.
DATABASE_MAX_OVERFLOW=20

# --- OpenSearch ------------------------------------------------------------
# Base URL of the OpenSearch cluster.
# docker compose overrides this with http://opensearch:9200.
OPENSEARCH_URL=http://localhost:9200
# Cluster username, if authentication is enabled.
OPENSEARCH_USERNAME=
# Cluster password, if authentication is enabled.
OPENSEARCH_PASSWORD=
# Index holding crawled, unverified content. Ingestion writes only here.
OPENSEARCH_STAGING_INDEX=panelpilot-staging
# Index serving answers. Written only by the promotion path after human
# review — see docs/adr/0001-staging-vs-production-index.md.
OPENSEARCH_PRODUCTION_INDEX=panelpilot-production

# --- LLM provider ----------------------------------------------------------
# Which vendor answers: `openai` or `anthropic`. Every generation path speaks
# one request shape; under `openai` it is translated by
# app/ai/openai_transport.py. The chosen provider's key is required at use.
LLM_PROVIDER=openai
# OpenAI key and model, used when LLM_PROVIDER=openai. The model must support
# function calling, and image input for photo recognition.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Claude key and model, used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Hard cap on output tokens per generation.
LLM_MAX_OUTPUT_TOKENS=4096
# Model calls one account may make per UTC calendar month, across diagnosis,
# photo recognition and PLC generation. Past it, calls are refused (429) until
# the month turns. Leave empty for no ceiling.
MODEL_CALLS_PER_MONTH=1000

# --- Embedding provider ----------------------------------------------------
# Retrieval's vector leg: `openai` (reuses OPENAI_API_KEY) or `voyage`.
#
# Refused at use rather than defaulted when misconfigured: vectors from a model
# the index was never built against fail silently rather than loudly.
EMBEDDING_PROVIDER=openai
# Only needed when EMBEDDING_PROVIDER=voyage. Named after the vendor so a key
# never silently holds the wrong account's credential.
VOYAGE_API_KEY=
# Every vector is 1024 wide, matching EMBEDDING_DIMENSIONS in
# app/ai/retrieval/mappings.py: text-embedding-3 models are asked for 1024
# directly; voyage-3.5 outputs it natively. Changing provider or model is a
# re-index (`python -m app.worker reindex-staging`), not a config edit.
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval and guardrails ----------------------------------------------
# Passages retrieved per query before filtering.
# Where uploaded equipment photos are written. A local directory in
# development; production points this at an S3-compatible mount. The domain
# talks to an ObjectStore port, so the backend is a composition-root swap.
IMAGE_STORAGE_ROOT=./var/images

RETRIEVAL_TOP_K=12
# Fused-score floor; below this a passage is not citable evidence.
# Hybrid scores are min-max normalised to [0, 1], so this is a fraction of
# the best hit in the result set, not a raw BM25 score.
RETRIEVAL_MIN_SCORE=0.05
# Absolute relevance floor: cosine similarity between the question and a
# passage. The fused score above only ranks -- the best hit of an off-topic
# question still scores near 1.0 -- so this is what keeps unrelated passages
# from being cited. Unset, it is measured and logged but not enforced. Set it
# from `python -m app.worker calibrate-relevance <eval_set.json>`, never by
# guessing: the right value depends on the embedding model and the corpus.
# RETRIEVAL_MIN_SIMILARITY=
# Confidence below which an answer is flagged low-confidence to the engineer.
GUARDRAIL_MIN_CONFIDENCE=0.6

# --- Security --------------------------------------------------------------
# Signing key for issued access tokens. Generate per environment; never reuse.
# Must be at least 32 bytes outside dev, or startup fails: python -c "import
# secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Signing algorithm: HS256 | HS384 | HS512. Anything else is refused.
JWT_ALGORITHM=HS256
# Access token lifetime, in seconds.
ACCESS_TOKEN_TTL_SECONDS=3600
# Comma-separated origins allowed to call the API from a browser.
# Leave empty to allow none. A JSON array works too. '*' is refused outside dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Request limits --------------------------------------------------------
# Largest request body accepted, in bytes, checked before anything parses it.
# Applies to every endpoint not listed below.
MAX_REQUEST_BODY_BYTES=65536
# Image upload. Must stay above the 8 MiB image limit plus multipart framing.
MAX_IMAGE_REQUEST_BODY_BYTES=9437184
# PLC generate/review, which accepts up to 100,000 characters of source.
MAX_PLC_REQUEST_BODY_BYTES=524288
# Panel design: schedule and price-list uploads (5 MiB) and projects to export.
MAX_DESIGN_REQUEST_BODY_BYTES=6291456

# --- Redis -----------------------------------------------------------------
# Redis connection URL, used for rate limiting and cached lookups.
# docker compose overrides this with redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
# Where the trial rate limiter counts requests: `redis` (shared by every
# worker — the only correct choice with more than one) or `memory` (one
# process, no Redis needed; each worker then gets its own allowance).
RATE_LIMIT_BACKEND=redis

# --- Ingestion -------------------------------------------------------------
# User-Agent the crawler identifies itself with. Include a contact address in
# deployed environments.
INGESTION_USER_AGENT=PanelPilotBot/0.1
# Concurrent fetches per crawl job.
INGESTION_MAX_CONCURRENCY=4

# --- Frontend --------------------------------------------------------------
# Where the web server proxies /api/v1/* to. Read at request time, so one image
# serves every environment. Unset, it defaults to http://localhost:8000 for
# `next dev` outside compose; compose sets http://api:8000 itself.
# API_PROXY_TARGET=http://localhost:8000
